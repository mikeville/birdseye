.env*

# Build / dependency outputs
node_modules/
dist/
dist-ssr/
.vite/

# TypeScript build cache
*.tsbuildinfo

# Local config and editor cruft
*.local
.DS_Store
.idea/
.vscode/

# Per-user Claude Code state. Keep .claude/launch.json (shared run config)
# and any settings.json (shared), but not the local override.
.claude/settings.local.json
.claude/worktrees/

# Generated data artifacts. basemap.pmtiles is regenerated by
# scripts/build-data.sh from the Protomaps daily build. At z0–7 it's ~136 MB,
# which exceeds GitHub's 100 MB push limit, so we treat it as a reproducible
# build artifact rather than versioned content. Re-run the script after a
# fresh clone before `pnpm dev`.
public/*.pmtiles
